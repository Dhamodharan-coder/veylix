generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth tables ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]

  vaultAccount     VaultAccount?
  vaultFolders     VaultFolder[]       @relation("VaultFolderOwner")
  vaultMemberships VaultFolderMember[] @relation("VaultMember")
  vaultItemShares  VaultItemShare[]    @relation("VaultShareRecipient")
  vaultFavorites   VaultFavorite[]
  vaultAuditLogs   VaultAuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Rate-limit counters: used by Better Auth (storage: "database") and by
// src/lib/rate-limit.ts for server actions, so limits hold across instances.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------- EnvMan tables ----------

model Project {
  id           String        @id @default(cuid())
  name         String
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  environments Environment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerId])
  @@map("project")
}

model Environment {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets   Secret[]
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@map("environment")
}

model Secret {
  id            String      @id @default(cuid())
  key           String
  // AES-256-GCM ciphertext, stored as "iv:authTag:ciphertext" (base64 parts)
  value         String
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, key])
  @@map("secret")
}

// ---------- Vault (zero-knowledge password manager) ----------
// Encrypted fields hold browser-made ciphertext ("v1.<iv>.<ct>"); the server
// never sees plaintext usernames, passwords, notes or keys.

enum VaultPermission {
  OWNER
  MANAGE
  MODIFY
  VIEW
}

enum VaultItemType {
  LOGIN
  SECURE_NOTE
}

model VaultAccount {
  userId                    String    @id
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kdfSalt                   String
  kdfIterations             Int
  publicKey                 String
  // RSA private key encrypted with the key derived from the master password
  encryptedPrivateKey       String
  // Same private key encrypted with the recovery key (shown once to the user)
  recoveryWrappedPrivateKey String?
  recoveryCreatedAt         DateTime?
  autoLockMinutes           Int       @default(15)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("vault_account")
}

model VaultFolder {
  id         String              @id @default(cuid())
  name       String
  ownerId    String
  owner      User                @relation("VaultFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPersonal Boolean             @default(false)
  members    VaultFolderMember[]
  items      VaultItem[]
  invites    VaultInvite[]
  auditLogs  VaultAuditLog[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([ownerId])
  @@map("vault_folder")
}

model VaultFolderMember {
  id                 String          @id @default(cuid())
  folderId           String
  folder             VaultFolder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId             String
  user               User            @relation("VaultMember", fields: [userId], references: [id], onDelete: Cascade)
  permission         VaultPermission
  // Folder key encrypted to this member's public key; null = awaiting access
  encryptedFolderKey String?
  addedById          String
  createdAt          DateTime        @default(now())

  @@unique([folderId, userId])
  @@index([userId])
  @@map("vault_folder_member")
}

model VaultInvite {
  id          String          @id @default(cuid())
  folderId    String?
  folder      VaultFolder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        VaultItem?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  email       String
  permission  VaultPermission
  invitedById String
  createdAt   DateTime        @default(now())

  @@index([email])
  @@map("vault_invite")
}

model VaultItem {
  id                String           @id @default(cuid())
  folderId          String
  folder            VaultFolder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  type              VaultItemType    @default(LOGIN)
  name              String
  url               String?
  tags              String[]
  // Item key encrypted with the folder key
  encryptedItemKey  String
  // JSON { username, password, notes } encrypted with the item key
  encryptedData     String
  passwordUpdatedAt DateTime         @default(now())
  createdById       String
  updatedById       String
  shares            VaultItemShare[]
  favorites         VaultFavorite[]
  invites           VaultInvite[]
  auditLogs         VaultAuditLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([folderId])
  @@map("vault_item")
}

model VaultItemShare {
  id               String          @id @default(cuid())
  itemId           String
  item             VaultItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation("VaultShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  permission       VaultPermission
  // Item key encrypted to the recipient's public key; null = awaiting access
  encryptedItemKey String?
  sharedById       String
  createdAt        DateTime        @default(now())

  @@unique([itemId, userId])
  @@index([userId])
  @@map("vault_item_share")
}

model VaultFavorite {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, itemId])
  @@map("vault_favorite")
}

model VaultAuditLog {
  id         String       @id @default(cuid())
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  folderId   String?
  folder     VaultFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  itemId     String?
  item       VaultItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  targetName String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  @@index([actorId, createdAt])
  @@index([folderId, createdAt])
  @@index([itemId, createdAt])
  @@map("vault_audit_log")
}
