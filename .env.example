# ---- Database (Neon) ----
# Pooled connection (host contains "-pooler") - used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same string WITHOUT "-pooler") - used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Better Auth ----
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Secret encryption (32 bytes, base64). Never change after storing secrets! ----
ENCRYPTION_KEY="generate with: openssl rand -base64 32"

# ---- Email ----
# false = no emails, no verification required, links printed to the terminal.
# Set to true once the mail service is integrated (see src/lib/email.ts).
EMAIL_ENABLED="false"
# Provider is picked automatically: SMTP (if SMTP_HOST or SMTP_URL is set), else Resend, else console.
# Test your settings with: npm run email:test -- you@example.com
EMAIL_FROM="Veylix <no-reply@yourdomain.com>"

# SMTP via Nodemailer (Gmail, Outlook, Zoho, SES, Brevo, Mailgun, ...)
SMTP_HOST=""
SMTP_PORT="587"
# "true" only for port 465 (implicit TLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Or a single URL instead of the above: smtp(s)://user:pass@host:port
SMTP_URL=""

# Or Resend (API)
RESEND_API_KEY=""

# ---- OAuth (optional - buttons only show when set) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate limiting (on by default). Set to "false" to disable, e.g. for local load testing.
RATE_LIMIT_ENABLED="true"
